# Copy to .env.local and fill in. Never commit real values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server-only. The browser never sees the API key; it fetches a signed URL from /api/agent-session.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Optional: pin a ConvAI agent branch.
# ELEVENLABS_BRANCH_ID=
